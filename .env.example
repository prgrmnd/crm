# DATABASE_URL é necessária para autenticação e acesso ao PostgreSQL/Prisma.
# Em produção com Neon + Vercel, use a string Pooled em DATABASE_URL
# e a string Direct (sem -pooler) em DIRECT_URL para executar migrations.
# Consulte o README para as variáveis usadas pelos scripts de validação.
# Defina BOOTSTRAP_ADMIN_* somente para executar npm run db:bootstrap-admin.
BOOTSTRAP_ADMIN_NAME=""
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
DATABASE_URL="postgresql://crm:crm@127.0.0.1:5432/crm?schema=public"
DIRECT_URL=""
